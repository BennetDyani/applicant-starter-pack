    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select fleet.dashboard_snapshot(nullif($1, '')::date, nullif($2, '')::date) as snapshot;",
        "options": {
          "queryReplacement": "={{ [ /^\\d{4}-\\d{2}-\\d{2}$/.test($json.query?.from ?? \"\") ? $json.query.from : \"\", /^\\d{4}-\\d{2}-\\d{2}$/.test($json.query?.to ?? \"\") ? $json.query.to : \"\" ] }}"
        }
      },
      "id": "8314145e-47aa-4de7-9631-d5db257131cf",
      "name": "Get dashboard snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        272,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "gXwqWXzAATayWL6E",
          "name": "Postgres - fleet_reader"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ typeof $json.snapshot === \"string\" ? JSON.parse($json.snapshot) : $json.snapshot }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "68d00831-456c-445f-a4f7-bb932c264df3",
      "name": "Send snapshot",
